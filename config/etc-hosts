# /etc/hosts — used during benchmarks
# Both nodes carry this identical file.
#
# IMPORTANT: Ubuntu 24.04 adds "127.0.1.1 hostname" by default.
# That entry must be removed. It causes OpenMPI to resolve the
# hostname to localhost and hang silently on mpirun bootstrap.

127.0.0.1 localhost

# The following lines are desirable for IPv6 capable hosts
::1     ip6-localhost ip6-loopback
fe00::0 ip6-localnet
ff00::0 ip6-mcastprefix
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters

# 100G benchmark network
192.168.100.1   pc1n-100g pc1n
192.168.100.2   pc2n-100g pc2n
